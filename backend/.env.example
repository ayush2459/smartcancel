PORT=8000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcancy
DB_USER=smartcancy_app
DB_PASSWORD=replace_with_your_local_database_password
DB_POOL_MAX=10

# AI Agent sidecar integration (optional — backend falls back safely if unset)
# Set AI_AGENT_URL to http://localhost:8081 when the sidecar is running.
AI_AGENT_URL=
# Shared secret between backend and agent. Must match AI_AGENT_SHARED_SECRET in the agent .env.
AI_AGENT_SHARED_SECRET=
# Timeout (ms) the backend waits for the agent sidecar before using the deterministic fallback.
AI_AGENT_TIMEOUT_MS=12000
