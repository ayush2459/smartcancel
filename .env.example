
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI agent sidecar. Keep this key server-side; never expose it through VITE_ variables.
AI_AGENT_PROVIDER="gemini"
GEMINI_MODEL="gemini-3.8-flash"
AI_AGENT_PORT="8081"
SCRE_API_BASE_URL="http://localhost:8000/api/v1"
AI_AGENT_BACKEND_TIMEOUT_MS="5000"
AI_AGENT_MODEL_TIMEOUT_MS="10000"
# Test-only: accepts {"snapshot": {...}} instead of fetching the backend decision endpoint.
AI_AGENT_ALLOW_INLINE_SNAPSHOT="false"
# SCRE_SERVICE_TOKEN="service-to-service-read-token"
# AI_AGENT_SHARED_SECRET="internal-sidecar-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"